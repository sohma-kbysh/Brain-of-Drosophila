# Copy to .env and fill in. .env is git-ignored -- NEVER commit a real token.
#
#   cp .env.example .env
#   # edit .env, then:
#   set -a && source .env && set +a
#
# Obtain a token from https://neuprint.janelia.org (Account -> Auth Token).
# If a token is ever committed or leaked, revoke it at Janelia immediately.

NEUPRINT_TOKEN=
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
